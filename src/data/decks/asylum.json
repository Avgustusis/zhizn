                      "label": "частная клиника",
                      "then": [{"add":{"возм":-4,"псих":4}},{"release":true,"noStigma":true}]
                    },
                    {"label":"отказаться","then":[]}
                  ]
                }
              ],
              "else": [{"say":"нет денег"},{"add":{"псих":-1}}]
            }
          ]
        }
      ],
      "doubts": [
        "«Частная клиника — −4 возм.; нет денег — −1 псих.» Записано: клиника доступна при возможностях 4 и выше, иначе −1 псих. В «Плохих анализах» платить можно и в минус — здесь иначе, потому что карта говорит «нет денег»? И если деньги есть, но игрок отказался — ничего?"
