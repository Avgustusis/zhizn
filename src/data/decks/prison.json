{
  "deck": "тюрьма",
  "cards": [
    {
      "id": "тюрьма.01",
      "n": 1,
      "title": "Камера на шестерых",
      "text": "",
      "src": "−1 псих.; d6 1–2 — драка, ещё −2 физ.",
      "kind": "Б",
      "tags": ["#насилие","#девиация"],
      "effect": [{"add":{"псих":-1}},{"d6":{"1-2":[{"say":"драка"},{"add":{"физ":-2}}]}}]
    },
    {
      "id": "тюрьма.02",
      "n": 2,
      "title": "Смотрящий",
      "text": "",
      "src": "🎲 Смекалка 15: успех — связь «Покровитель» (ключ к Мафии); провал — −2 физ.",
      "kind": "П",
      "tags": ["#девиация","#связи"],
      "effect": [
        {
          "check": {"stat":"Смекалка","dc":15},
          "success": [{"gain":"Покровитель"},{"say":"ключ к Мафии"}],
          "failure": [{"add":{"физ":-2}}]
        }
      ]
    },
    {
      "id": "тюрьма.03",
      "n": 3,
      "title": "Тюремная библиотека",
      "text": "",
      "src": "+1 Интеллект или +1 Мудрость (потолок рынка не действует: это событие)",
      "kind": "Б",
      "tags": ["#образование"],
      "effect": [{"addOneOf":["Интеллект","Мудрость"],"n":1},{"say":"потолок рынка не действует: это событие"}]
    },
    {
      "id": "тюрьма.04",
      "n": 4,
      "title": "Письмо из дома",
      "text": "",
      "src": "Сплочённость +1 и выше, Партнёр или Супруг(а) — +2 псих.; иначе −1 псих. (никто не пишет)",
      "kind": "Б",
      "tags": ["#семья"],
      "effect": [
        {
          "if": {"any":[{"p":"Сплочённость","gte":1},{"has":"Партнёр"},{"has":"Супруг(а)"}]},
          "then": [{"add":{"псих":2}}],
          "else": [{"say":"никто не пишет"},{"add":{"псих":-1}}]
        }
      ]
    },
    {
      "id": "тюрьма.05",
      "n": 5,
      "title": "Не дождались",
      "text": "",
      "src": "Есть Партнёр (не Супруг): связь теряется, −3 псих. Нет — карта в сброс",
      "kind": "Б",
      "tags": ["#любовь"],
      "requires": {"has":"Партнёр"},
      "effect": [{"lose":"Партнёр"},{"add":{"псих":-3}}]
    },
    {
      "id": "тюрьма.06",
      "n": 6,
      "title": "УДО",
      "text": "",
      "src": "🎲 Харизма 15: успех — срок −2 хода",
      "kind": "П",
      "tags": ["#закон"],
      "effect": [{"check":{"stat":"Харизма","dc":15},"success":[{"term":-2}],"failure":[]}]
    },
    {
      "id": "тюрьма.07",
      "n": 7,
      "title": "Шмон",
      "text": "",
      "src": "Обыск: один козырь (если есть) нашли и изъяли. Нечего изымать — −1 псих. за компанию",
      "kind": "Б",
      "tags": ["#закон"],
      "effect": [
        {
          "if": {"hasKind":"козырь"},
          "then": [{"say":"обыск"},{"rule":"изъять козырь"}],
          "else": [{"say":"нечего изымать"},{"add":{"псих":-1}}]
        }
      ]
    },
    {
      "id": "тюрьма.08",
      "n": 8,
      "title": "Промзона",
