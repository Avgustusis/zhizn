      "tags": ["#здоровье"],
      "effect": [
        {
          "check": {"stat":"Выносливость","dc":12,"mods":[{"if":{"pos":["периферия"]},"dc":15}]},
          "success": [],
          "failure": [{"add":{"физ":-3}}]
        }
      ]
    },
    {
